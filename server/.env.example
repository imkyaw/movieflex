NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=file:./dev.db
IDENTITY_PROVIDER=local
LOCAL_JWT_SECRET=replace-with-at-least-32-characters

# Required in production for AWS services
AWS_REGION=ap-southeast-2

# Required only when IDENTITY_PROVIDER=cognito
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Required in production for private S3 poster storage
POSTER_BUCKET_NAME=
