{
  "name": "@movieflex/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate --schema prisma/sqlite/schema.prisma",
    "prisma:generate:postgres": "prisma generate --schema prisma/postgres/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/sqlite/schema.prisma",
    "db:migrate:postgres": "prisma migrate deploy --schema prisma/postgres/schema.prisma",
    "db:seed": "prisma db seed --schema prisma/sqlite/schema.prisma",
    "db:reset": "prisma migrate reset --schema prisma/sqlite/schema.prisma"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1121.0",
    "@prisma/client": "6.19.3",
    "aws-jwt-verify": "^5.2.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.2.0",
    "prisma": "6.19.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
