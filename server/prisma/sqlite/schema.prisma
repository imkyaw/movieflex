generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  userId     String   @id @default(uuid())
  cognitoSub String   @unique
  email      String   @unique
  name       String
  role       String   @default("USER")
  createdAt  DateTime @default(now())
  orders     Order[]
}

model Movie {
  movieId        String        @id @default(uuid())
  title          String
  description    String
  genre          String
  director       String
  releaseDate    DateTime
  classification String
  runtimeMinutes Int
  priceCents     Int
  stock          Int
  posterKey      String?
  status         String        @default("ACTIVE")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  orderDetails   OrderDetail[]

  @@index([genre])
  @@index([title])
  @@index([status])
}

model Order {
  orderId    String        @id @default(uuid())
  userId     String
  totalCents Int
  status     String        @default("PAID")
  createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [userId], onDelete: Restrict)
  details    OrderDetail[]

  @@index([userId])
}

model OrderDetail {
  id             String @id @default(uuid())
  orderId        String
  movieId        String
  title          String
  quantity       Int
  unitPriceCents Int
  order          Order  @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  movie          Movie  @relation(fields: [movieId], references: [movieId], onDelete: Restrict)

  @@index([orderId])
}
