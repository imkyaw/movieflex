generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum MovieStatus {
  ACTIVE
  DISCONTINUED
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  CART
  PAID
  CANCELLED
}

model User {
  userId     String     @id @default(uuid()) @db.Uuid
  cognitoSub String     @unique
  email      String     @unique
  name       String
  role       UserRole   @default(USER)
  status     UserStatus @default(ACTIVE)
  createdAt  DateTime   @default(now()) @db.Timestamptz
  orders     Order[]
  reviews    Review[]

  @@index([status])
}

model Movie {
  movieId        String        @id @default(uuid()) @db.Uuid
  title          String
  description    String
  genre          String
  director       String
  releaseDate    DateTime      @db.Date
  classification String
  runtimeMinutes Int
  priceCents     Int
  stock          Int
  posterUrl      String?
  status         MovieStatus   @default(ACTIVE)
  createdAt      DateTime      @default(now()) @db.Timestamptz
  updatedAt      DateTime      @updatedAt @db.Timestamptz
  orderDetails   OrderDetail[]
  reviews        Review[]

  @@index([genre])
  @@index([title])
  @@index([status])
}

model Order {
  orderId    String        @id @default(uuid()) @db.Uuid
  userId     String        @db.Uuid
  totalCents Int           @default(0)
  status     OrderStatus   @default(CART)
  createdAt  DateTime      @default(now()) @db.Timestamptz
  user       User          @relation(fields: [userId], references: [userId], onDelete: Restrict)
  details    OrderDetail[]

  @@index([userId])
  @@index([userId, status])
}

model OrderDetail {
  id             String @id @default(uuid()) @db.Uuid
  orderId        String @db.Uuid
  movieId        String @db.Uuid
  title          String
  quantity       Int
  unitPriceCents Int
  order          Order  @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  movie          Movie  @relation(fields: [movieId], references: [movieId], onDelete: Restrict)

  @@unique([orderId, movieId])
  @@index([orderId])
}

model Review {
  reviewId  String   @id @default(uuid()) @db.Uuid
  movieId   String   @db.Uuid
  userId    String   @db.Uuid
  rating    Int
  comment   String
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  movie     Movie    @relation(fields: [movieId], references: [movieId], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([movieId, userId])
  @@index([movieId])
}
